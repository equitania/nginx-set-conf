# nginx-set-conf v1.20.0 | python/uv
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
▸ Setup:   uv venv --python 3.14 && venv+ && uv pip install -e ".[dev]"
▸ Wizard:  nginx-set-conf wizard --dry_run
▸ Server:  nginx-set-conf --config_path=/root/docker-builds/ngx-conf
▸ Test:    uv run pytest -q
▸ Check:   uv run ruff check . && uv run ruff format --check . && uv run mypy nginx_set_conf
▸ Build:   uv build
▸ Bump:    bump-my-version bump patch --allow-dirty --no-commit --no-tag && uv lock
▸ Python:  3.14 (CI matrix 3.10–3.14), >=3.10 (pyproject.toml)
